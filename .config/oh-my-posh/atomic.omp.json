{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#7E9CD8",
          "foreground": "#1F1F28",
          "leading_diamond": "╭─",
          "style": "diamond",
          "template": " {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "#E46876",
          "foreground": "#DCD7BA",
          "style": "diamond",
          "template": "<parentBackground></>  ",
          "type": "root"
        },
        {
          "background": "#FFA066",
          "foreground": "#1F1F28",
          "powerline_symbol": "",
          "options": {
            "folder_icon": "  ",
            "home_icon": "",
            "style": "folder"
          },
          "style": "powerline",
          "template": "  {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#E6C384",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#E46876{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#7FB4CA{{ end }}",
            "{{ if gt .Ahead 0 }}#957FB8{{ end }}",
            "{{ if gt .Behind 0 }}#957FB8{{ end }}"
          ],
          "foreground": "#1F1F28",
          "powerline_symbol": "",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#E46876>  {{ .Staging.String }}</>{{ end }} ",
          "type": "git"
        },
        {
          "background": "#54546D",
          "foreground": "#DCD7BA",
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": "  {{ .FormattedMs }} ",
          "trailing_diamond": "",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#1F1F28",
          "foreground": "#DCD7BA",
          "leading_diamond": "",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <#E46876></> ",
            "yarn_icon": " <#7FB4CA></>"
          },
          "style": "diamond",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "trailing_diamond": " ",
          "type": "node"
        },
        {
          "background": "#7E9CD8",
          "foreground": "#1F1F28",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "python"
        },
        {
          "background": "#7FB4CA",
          "foreground": "#1F1F28",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "java"
        },
        {
          "background": "#16161D",
          "foreground": "#DCD7BA",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Unsupported }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "dotnet"
        },
        {
          "background": "#FFA066",
          "foreground": "#1F1F28",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "go"
        },
        {
          "background": "#E6C384",
          "foreground": "#1F1F28",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "rust"
        },
        {
          "background": "#7FB4CA",
          "foreground": "#1F1F28",
          "leading_diamond": " ",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "dart"
        },
        {
          "background": "#E46876",
          "foreground": "#DCD7BA",
          "leading_diamond": " ",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "angular"
        },
        {
          "background": "#957FB8",
          "foreground": "#1F1F28",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "α {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "aurelia"
        },
        {
          "background": "#1F1F28",
          "foreground": "#DCD7BA",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "nx"
        },
        {
          "background": "#7E9CD8",
          "foreground": "#1F1F28",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "<#E46876></> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "julia"
        },
        {
          "background": "#363646",
          "foreground": "#DCD7BA",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "ruby"
        },
        {
          "background": "#7FB4CA",
          "foreground": "#1F1F28",
          "leading_diamond": "",
          "style": "diamond",
          "template": "<#E6C384></> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "azfunc"
        },
        {
          "background": "#54546D",
          "foreground": "#DCD7BA",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "trailing_diamond": " ",
          "type": "aws"
        },
        {
          "background": "#7E9CD8",
          "foreground": "#1F1F28",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "trailing_diamond": "",
          "type": "kubectl"
        },
        {
          "background": "#363646",
          "foreground": "#DCD7BA",
          "leading_diamond": "",
          "trailing_diamond": "<transparent,background></>",
          "options": {
            "linux": "",
            "macos": "",
            "windows": ""
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "#E46876",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#7E9CD8{{end}}",
            "{{if eq \"Discharging\" .State.String}}#E6C384{{end}}",
            "{{if eq \"Full\" .State.String}}#98BB6C{{end}}"
          ],
          "foreground": "#1F1F28",
          "invert_powerline": true,
          "powerline_symbol": "",
          "options": {
            "charged_icon": " ",
            "charging_icon": " ",
            "discharging_icon": " "
          },
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }} ",
          "type": "battery"
        },
        {
          "background": "#957FB8",
          "foreground": "#1F1F28",
          "invert_powerline": true,
          "leading_diamond": "",
          "options": {
            "time_format": "_2,15:04"
          },
          "style": "diamond",
          "template": "  {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#54546D",
          "style": "plain",
          "template": "╰─",
          "type": "text"
        },
        {
          "foreground": "#DCD7BA",
          "foreground_templates": ["{{ if gt .Code 0 }}#E46876{{ end }}"],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
