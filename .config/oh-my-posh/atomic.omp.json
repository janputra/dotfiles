{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#ca9ee6",
          "foreground": "#303446",
          "leading_diamond": "╭─",
          "style": "diamond",
          "template": " {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "#e78284",
          "foreground": "#c6d0f5",
          "style": "diamond",
          "template": "<parentBackground></>  ",
          "type": "root"
        },
        {
          "background": "#ef9f76",
          "foreground": "#303446",
          "powerline_symbol": "",
          "options": {
            "folder_icon": "  ",
            "home_icon": "",
            "style": "folder"
          },
          "style": "powerline",
          "template": "  {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#e5c890",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#e78284{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#99d1db{{ end }}",
            "{{ if gt .Ahead 0 }}#f4b8e4{{ end }}",
            "{{ if gt .Behind 0 }}#f4b8e4{{ end }}"
          ],
          "foreground": "#303446",
          "powerline_symbol": "",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#e78284>  {{ .Staging.String }}</>{{ end }} ",
          "type": "git"
        },
        {
          "background": "#626880",
          "foreground": "#c6d0f5",
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": "  {{ .FormattedMs }} ",
          "trailing_diamond": "",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#303446",
          "foreground": "#c6d0f5",
          "leading_diamond": "",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <#e78284></> ",
            "yarn_icon": " <#99d1db></>"
          },
          "style": "diamond",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "trailing_diamond": " ",
          "type": "node"
        },
        {
          "background": "#ca9ee6",
          "foreground": "#303446",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "python"
        },
        {
          "background": "#99d1db",
          "foreground": "#303446",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "java"
        },
        {
          "background": "#292c3c",
          "foreground": "#c6d0f5",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Unsupported }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "dotnet"
        },
        {
          "background": "#ef9f76",
          "foreground": "#303446",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "go"
        },
        {
          "background": "#e5c890",
          "foreground": "#303446",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "rust"
        },
        {
          "background": "#99d1db",
          "foreground": "#303446",
          "leading_diamond": " ",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "dart"
        },
        {
          "background": "#e78284",
          "foreground": "#c6d0f5",
          "leading_diamond": " ",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "angular"
        },
        {
          "background": "#f4b8e4",
          "foreground": "#303446",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "α {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "aurelia"
        },
        {
          "background": "#303446",
          "foreground": "#c6d0f5",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "nx"
        },
        {
          "background": "#ca9ee6",
          "foreground": "#303446",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "<#e78284></> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "julia"
        },
        {
          "background": "#414559",
          "foreground": "#c6d0f5",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "ruby"
        },
        {
          "background": "#99d1db",
          "foreground": "#303446",
          "leading_diamond": "",
          "style": "diamond",
          "template": "<#e5c890></> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "azfunc"
        },
        {
          "background": "#626880",
          "foreground": "#c6d0f5",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "trailing_diamond": " ",
          "type": "aws"
        },
        {
          "background": "#ca9ee6",
          "foreground": "#303446",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "trailing_diamond": "",
          "type": "kubectl"
        },
        {
          "background": "#414559",
          "foreground": "#c6d0f5",
          "leading_diamond": "",
          "trailing_diamond": "<transparent,background></>",
          "options": {
            "linux": "",
            "macos": "",
            "windows": ""
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "#e78284",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#ca9ee6{{end}}",
            "{{if eq \"Discharging\" .State.String}}#e5c890{{end}}",
            "{{if eq \"Full\" .State.String}}#a6d189{{end}}"
          ],
          "foreground": "#303446",
          "invert_powerline": true,
          "powerline_symbol": "",
          "options": {
            "charged_icon": " ",
            "charging_icon": " ",
            "discharging_icon": " "
          },
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }} ",
          "type": "battery"
        },
        {
          "background": "#f4b8e4",
          "foreground": "#303446",
          "invert_powerline": true,
          "leading_diamond": "",
          "options": {
            "time_format": "_2,15:04"
          },
          "style": "diamond",
          "template": "  {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#626880",
          "style": "plain",
          "template": "╰─",
          "type": "text"
        },
        {
          "foreground": "#c6d0f5",
          "foreground_templates": ["{{ if gt .Code 0 }}#e78284{{ end }}"],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
