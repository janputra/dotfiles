{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#bd93f9",
          "foreground": "#282a36",
          "leading_diamond": "╭─",
          "style": "diamond",
          "template": " {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "#ff5555",
          "foreground": "#f8f8f2",
          "style": "diamond",
          "template": "<parentBackground></>  ",
          "type": "root"
        },
        {
          "background": "#ffb86c",
          "foreground": "#282a36",
          "powerline_symbol": "",
          "options": {
            "folder_icon": "  ",
            "home_icon": "",
            "style": "folder"
          },
          "style": "powerline",
          "template": "  {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#f1fa8c",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ff5555{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#8be9fd{{ end }}",
            "{{ if gt .Ahead 0 }}#ff79c6{{ end }}",
            "{{ if gt .Behind 0 }}#ff79c6{{ end }}"
          ],
          "foreground": "#282a36",
          "powerline_symbol": "",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#ff5555>  {{ .Staging.String }}</>{{ end }} ",
          "type": "git"
        },
        {
          "background": "#6272a4",
          "foreground": "#f8f8f2",
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "style": "diamond",
          "template": "  {{ .FormattedMs }} ",
          "trailing_diamond": "",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#282a36",
          "foreground": "#f8f8f2",
          "leading_diamond": "",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <#ff5555></> ",
            "yarn_icon": " <#8be9fd></>"
          },
          "style": "diamond",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "trailing_diamond": " ",
          "type": "node"
        },
        {
          "background": "#bd93f9",
          "foreground": "#282a36",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "python"
        },
        {
          "background": "#8be9fd",
          "foreground": "#282a36",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "java"
        },
        {
          "background": "#21222c",
          "foreground": "#f8f8f2",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Unsupported }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "dotnet"
        },
        {
          "background": "#ffb86c",
          "foreground": "#282a36",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "go"
        },
        {
          "background": "#f1fa8c",
          "foreground": "#282a36",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "rust"
        },
        {
          "background": "#8be9fd",
          "foreground": "#282a36",
          "leading_diamond": " ",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "dart"
        },
        {
          "background": "#ff5555",
          "foreground": "#f8f8f2",
          "leading_diamond": " ",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "angular"
        },
        {
          "background": "#ff79c6",
          "foreground": "#282a36",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "α {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "aurelia"
        },
        {
          "background": "#282a36",
          "foreground": "#f8f8f2",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "nx"
        },
        {
          "background": "#bd93f9",
          "foreground": "#282a36",
          "leading_diamond": " ",
          "style": "diamond",
          "template": "<#ff5555></> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "julia"
        },
        {
          "background": "#44475a",
          "foreground": "#f8f8f2",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "ruby"
        },
        {
          "background": "#8be9fd",
          "foreground": "#282a36",
          "leading_diamond": "",
          "style": "diamond",
          "template": "<#f1fa8c></> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": " ",
          "type": "azfunc"
        },
        {
          "background": "#6272a4",
          "foreground": "#f8f8f2",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "trailing_diamond": " ",
          "type": "aws"
        },
        {
          "background": "#bd93f9",
          "foreground": "#282a36",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "trailing_diamond": "",
          "type": "kubectl"
        },
        {
          "background": "#44475a",
          "foreground": "#f8f8f2",
          "leading_diamond": "",
          "trailing_diamond": "<transparent,background></>",
          "options": {
            "linux": "",
            "macos": "",
            "windows": ""
          },
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "background": "#ff5555",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#bd93f9{{end}}",
            "{{if eq \"Discharging\" .State.String}}#f1fa8c{{end}}",
            "{{if eq \"Full\" .State.String}}#50fa7b{{end}}"
          ],
          "foreground": "#282a36",
          "invert_powerline": true,
          "powerline_symbol": "",
          "options": {
            "charged_icon": " ",
            "charging_icon": " ",
            "discharging_icon": " "
          },
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }} ",
          "type": "battery"
        },
        {
          "background": "#ff79c6",
          "foreground": "#282a36",
          "invert_powerline": true,
          "leading_diamond": "",
          "options": {
            "time_format": "_2,15:04"
          },
          "style": "diamond",
          "template": "  {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#6272a4",
          "style": "plain",
          "template": "╰─",
          "type": "text"
        },
        {
          "foreground": "#f8f8f2",
          "foreground_templates": ["{{ if gt .Code 0 }}#ff5555{{ end }}"],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
